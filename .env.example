# App
VITE_APP_ID=
# O JWT_SECRET deve ter pelo menos 32 caracteres para seguranca.
# No Vercel, adicione em Project Settings > Environment Variables.
JWT_SECRET=your_very_long_secret_at_least_32_characters_long
NODE_ENV=production

## Database (Drizzle)
# Priorize DATABASE_URL (ou use POSTGRES_URL, se preferir)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true

## Supabase (Client - Vite)
# Necessario no build (VITE_ fica embutido no frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

## Supabase (Server - Vercel Functions)
# Necessario em runtime no backend (não exponha no client)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

## AI / Integracoes (se o app usar)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

